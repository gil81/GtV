+    fun `audio-only change preserves subtitle override in shared groups`() {
+        val source =
+            TestTracks
+                .Builder()
+                .addVideo()
+                .addAudio(2)
+                .addSubtitle(2)
+                .buildMediaSourceInfo()
+        val audioFormats =
+            arrayOf(
+                Format.Builder().setId("1").setLanguage("pol").setSampleMimeType("audio/eac3").build(),
+                Format.Builder().setId("2").setLanguage("eng").setSampleMimeType("audio/eac3").build(),
