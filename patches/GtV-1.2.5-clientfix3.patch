+        val subtitleFormats =
+            arrayOf(
+                Format.Builder().setId("3").setLanguage("ita").setSampleMimeType("text/vtt").build(),
+                Format.Builder().setId("4").setLanguage("eng").setSampleMimeType("text/vtt").build(),
+            )
+        val audioGroup = TrackGroup(*audioFormats)
+        val subtitleGroup = TrackGroup(*subtitleFormats)
+        val tracks =
